generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTENTICACIÓN Y TENANCY ====================

model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  logo             String?
  timezone         String    @default("America/Santiago")
  country          String    @default("CL") // CL, MX, CO, AR, PE, etc.
  currency         String    @default("CLP")
  plan             Plan      @default(FREE)
  planExpiresAt    DateTime?
  stripeCustomerId String?   @unique
  mercadoPagoId    String?   @unique
  whatsappPhoneId  String? // WhatsApp Business Phone ID
  whatsappToken    String? // Encrypted
  googleCalendarId String?

  // Configuración del agente IA
  aiAgentName         String  @default("Asistente")
  aiAgentPersonality  String  @default("profesional y amable")
  aiAgentInstructions String? @db.Text // Instrucciones personalizadas
  aiAutoReply         Boolean @default(true)
  aiWorkingHours      Json? // { mon: { start: "09:00", end: "18:00" }, ... }

  // Configuración de negocio
  businessType  String  @default("dental_clinic")
  businessHours Json?
  address       String?
  phone         String?
  email         String?
  website       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Member[]
  patients      Patient[]
  conversations Conversation[]
  appointments  Appointment[]
  services      Service[]
  invoices      Invoice[]
  campaigns     Campaign[]
  automations   Automation[]
  documents     Document[]
  templates     MessageTemplate[]
  tags          Tag[]
  customFields  CustomField[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([slug])
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  avatar        String?
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Member[]
  accounts Account[] // OAuth accounts
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Member {
  id             String     @id @default(cuid())
  role           MemberRole @default(STAFF)
  userId         String
  organizationId String
  isActive       Boolean    @default(true)

  createdAt DateTime @default(now())

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("AssignedTo")
  messages              Message[]

  @@unique([userId, organizationId])
}

enum MemberRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

// ==================== CRM / PACIENTES ====================

model Patient {
  id             String @id @default(cuid())
  organizationId String

  // Datos personales
  firstName      String
  lastName       String
  email          String?
  phone          String? // Número principal (WhatsApp)
  phoneSecondary String?
  rut            String? // Chile: RUT, México: CURP/RFC
  dateOfBirth    DateTime?
  gender         String?
  avatar         String?

  // Datos médicos (dental)
  medicalNotes    String?   @db.Text
  allergies       String?
  medications     String?
  lastVisit       DateTime?
  nextAppointment DateTime?

  // Segmentación
  source String? // whatsapp, website, referral, walk-in
  status PatientStatus @default(ACTIVE)
  score  Int           @default(0) // Lead scoring

  // Financiero
  balance       Decimal @default(0) @db.Decimal(10, 2)
  lifetimeValue Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  appointments      Appointment[]
  invoices          Invoice[]
  payments          Payment[]
  tags              PatientTag[]
  customFieldValues CustomFieldValue[]
  documents         PatientDocument[]

  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, status])
}

enum PatientStatus {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Tag {
  id             String @id @default(cuid())
  organizationId String
  name           String
  color          String @default("#6366f1")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients     PatientTag[]

  @@unique([organizationId, name])
}

model PatientTag {
  patientId String
  tagId     String

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([patientId, tagId])
}

model CustomField {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  type           String // text, number, date, select, boolean
  options        Json? // Para type=select
  required       Boolean @default(false)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]
}

model CustomFieldValue {
  id            String @id @default(cuid())
  patientId     String
  customFieldId String
  value         String

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([patientId, customFieldId])
}

// ==================== CONVERSACIONES ====================

model Conversation {
  id             String  @id @default(cuid())
  organizationId String
  patientId      String?

  channel   Channel            @default(WHATSAPP)
  channelId String? // WhatsApp phone, email address, etc.
  status    ConversationStatus @default(OPEN)
  priority  Priority           @default(NORMAL)

  // IA
  aiEnabled   Boolean @default(true)
  aiHandedOff Boolean @default(false) // IA delegó a humano
  aiSummary   String? @db.Text
  aiSentiment String? // positive, neutral, negative

  assignedToId  String?
  lastMessageAt DateTime?
  resolvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id])
  assignedTo   Member?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  messages     Message[]

  @@index([organizationId, status, lastMessageAt])
  @@index([organizationId, channel])
  @@index([patientId])
}

enum Channel {
  WHATSAPP
  EMAIL
  SMS
  WEB_CHAT
  INSTAGRAM
  FACEBOOK
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Message {
  id             String @id @default(cuid())
  conversationId String

  direction MessageDirection
  sender    MessageSender
  senderId  String? // Member ID si es humano

  // Contenido
  type      MessageType @default(TEXT)
  content   String?     @db.Text
  mediaUrl  String?
  mediaType String? // image/jpeg, audio/ogg, application/pdf, etc.

  // WhatsApp específico
  whatsappMsgId  String? @unique
  whatsappStatus String? // sent, delivered, read, failed

  // IA
  aiGenerated  Boolean @default(false)
  aiConfidence Float?
  aiToolsUsed  Json? // Herramientas usadas por la IA

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([whatsappMsgId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  PATIENT
  AGENT // Humano
  AI // IA
  SYSTEM // Notificaciones del sistema
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  TEMPLATE
  INTERACTIVE
}

// ==================== CITAS / CALENDARIO ====================

model Service {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?
  duration       Int // En minutos
  price          Decimal @db.Decimal(10, 2)
  currency       String  @default("CLP")
  color          String  @default("#6366f1")
  isActive       Boolean @default(true)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoiceItems InvoiceItem[]
}

model Appointment {
  id             String  @id @default(cuid())
  organizationId String
  patientId      String
  serviceId      String?

  title     String
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(CONFIRMED)
  notes     String?           @db.Text

  // Recordatorios
  reminder24hSent Boolean @default(false)
  reminder1hSent  Boolean @default(false)

  // Google Calendar
  googleEventId String?

  // IA
  bookedByAi Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id])

  @@index([organizationId, startTime])
  @@index([patientId])
  @@index([status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ==================== FACTURACIÓN Y PAGOS ====================

model Invoice {
  id             String @id @default(cuid())
  organizationId String
  patientId      String

  number String // Folio
  status InvoiceStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("CLP")

  // Facturación electrónica
  dteType  String? // Chile: 33 (factura), 39 (boleta) | México: tipo CFDI
  dteFolio String?
  dteXml   String? @db.Text
  dtePdf   String? // URL al PDF

  dueDate DateTime?
  paidAt  DateTime?
  sentAt  DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@index([organizationId, status])
  @@index([organizationId, number])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
}

model Payment {
  id        String @id @default(cuid())
  invoiceId String
  patientId String

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("CLP")
  method   PaymentMethod
  status   PaymentStatus @default(PENDING)

  // Pasarela de pago
  stripePaymentId      String?
  mercadoPagoPaymentId String?

  reference String?
  notes     String?

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  STRIPE
  MERCADOPAGO
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==================== CAMPAÑAS Y AUTOMATIZACIONES ====================

model Campaign {
  id             String @id @default(cuid())
  organizationId String

  name   String
  type   CampaignType
  status CampaignStatus @default(DRAFT)

  // Contenido
  channel    Channel @default(WHATSAPP)
  templateId String?
  content    String? @db.Text

  // Audiencia
  audienceFilter Json? // Filtros para seleccionar pacientes
  audienceCount  Int   @default(0)

  // Métricas
  sentCount      Int @default(0)
  deliveredCount Int @default(0)
  readCount      Int @default(0)
  repliedCount   Int @default(0)
  failedCount    Int @default(0)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     MessageTemplate? @relation(fields: [templateId], references: [id])

  @@index([organizationId, status])
}

enum CampaignType {
  BROADCAST // Envío masivo
  REACTIVATION // Reactivar pacientes inactivos
  REMINDER // Recordatorios
  FOLLOW_UP // Seguimiento post-cita
  PROMOTIONAL // Promociones
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

model MessageTemplate {
  id             String @id @default(cuid())
  organizationId String

  name     String
  channel  Channel @default(WHATSAPP)
  category String? // WhatsApp template category
  language String  @default("es")

  // Contenido
  headerType    String? // text, image, document, video
  headerContent String?
  body          String  @db.Text
  footer        String?
  buttons       Json? // Botones interactivos

  // WhatsApp
  whatsappTemplateId String? // ID en Meta
  whatsappStatus     String? // approved, pending, rejected

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
}

model Automation {
  id             String @id @default(cuid())
  organizationId String

  name          String
  description   String?
  trigger       AutomationTrigger
  triggerConfig Json // Configuración del trigger
  actions       Json // Array de acciones a ejecutar

  isActive       Boolean   @default(true)
  executionCount Int       @default(0)
  lastExecutedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum AutomationTrigger {
  NEW_PATIENT // Nuevo paciente registrado
  APPOINTMENT_BOOKED // Cita agendada
  APPOINTMENT_COMPLETED // Cita completada
  APPOINTMENT_NO_SHOW // No show
  APPOINTMENT_CANCELLED // Cita cancelada
  PAYMENT_RECEIVED // Pago recibido
  INVOICE_OVERDUE // Factura vencida
  PATIENT_INACTIVE // Paciente inactivo por X días
  MESSAGE_RECEIVED // Mensaje recibido con keyword
  CUSTOM_DATE // Fecha personalizada (cumpleaños, etc.)
}

// ==================== DOCUMENTOS Y RAG ====================

model Document {
  id             String @id @default(cuid())
  organizationId String

  name    String
  type    String // faq, protocol, price-list, consent, etc.
  content String  @db.Text
  fileUrl String?

  // Embeddings para RAG
  isIndexed  Boolean @default(false)
  chunkCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]
}

model DocumentChunk {
  id         String  @id @default(cuid())
  documentId String
  content    String  @db.Text
  embedding  Float[] // pgvector
  chunkIndex Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model PatientDocument {
  id        String  @id @default(cuid())
  patientId String
  name      String
  type      String // xray, consent, prescription, photo, etc.
  fileUrl   String
  notes     String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ==================== NOTIFICACIONES Y AUDITORÍA ====================

model Notification {
  id             String @id @default(cuid())
  organizationId String

  type   String // new_message, appointment_reminder, payment, etc.
  title  String
  body   String
  data   Json?
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isRead, createdAt])
}

model AuditLog {
  id             String @id @default(cuid())
  organizationId String

  action    String // create, update, delete, login, etc.
  entity    String // patient, appointment, invoice, etc.
  entityId  String?
  details   Json?
  userId    String?
  ipAddress String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entity])
}
