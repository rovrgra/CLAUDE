# ===========================================
# RestoBOT - Variables de entorno
# ===========================================
# Copia este archivo como .env y configura los valores

# --- Base de datos (PostgreSQL) ---
# Si usas docker-compose: postgresql://restobot:restobot123@localhost:5432/restobot?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/restobot?schema=public"

# --- NextAuth ---
# Genera un secreto seguro: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# --- Claude AI (Anthropic) ---
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- WhatsApp Business API (Meta) ---
# Obtener en: https://developers.facebook.com/apps
WHATSAPP_VERIFY_TOKEN="your-verify-token"

# --- Stripe (opcional) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- MercadoPago (opcional) ---
MERCADOPAGO_ACCESS_TOKEN=""
